{
  "name": "geotimelapse",
  "version": "0.2.0",
  "description": "Replay a day of geolocated events on a dark glowing map",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FranckErnewein/geotimelapse.git",
    "directory": "packages/geotimelapse"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./duckdb": {
      "types": "./dist/duckdb-source.d.ts",
      "import": "./dist/duckdb-source.js",
      "default": "./dist/duckdb-source.js"
    },
    "./synthetic": {
      "types": "./dist/synthetic-source.d.ts",
      "import": "./dist/synthetic-source.js",
      "default": "./dist/synthetic-source.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tailwindcss -i src/styles.css -o dist/styles.css --minify",
    "prepublishOnly": "pnpm build",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/*.test.ts"
  },
  "peerDependencies": {
    "deck.gl": ">=9.4.0",
    "mapbox-gl": ">=3.0.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0",
    "react-map-gl": ">=8.0.0"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "1.33.1-dev57.0",
    "@heroicons/react": "^2.2.0",
    "date-fns": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@types/react": "^19.0.0",
    "deck.gl": "^9.4.0",
    "mapbox-gl": "^3.30.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-map-gl": "^8.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "@tailwindcss/cli": "^4.1.0",
    "tailwindcss": "^4.1.0"
  }
}
